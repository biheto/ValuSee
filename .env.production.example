APP_PORT=8000
POSTGRES_PASSWORD=replace-with-a-long-random-password
RABBITMQ_PASSWORD=replace-with-a-long-random-password
MINIO_ROOT_USER=valuesee-storage
MINIO_ROOT_PASSWORD=replace-with-a-long-random-password
VALUSee_JWT_SECRET=replace-with-at-least-32-random-bytes
VALUSee_ADMIN_EMAILS=admin@example.com
ALLOWED_HOSTS=shop.example.com
ALLOWED_ORIGINS=https://shop.example.com
VALUSee_PUBLIC_BASE_URL=https://shop.example.com
VALUSee_METRICS_TOKEN=replace-with-a-long-random-metrics-token
# Shared only by the API and the Cloudflare Cron Worker. Use 32+ random bytes.
VALUSee_CRON_SECRET=replace-with-a-long-random-cron-secret
# Public monitor checks per scheduled invocation (clamped to 1..20).
VALUSee_MONITOR_BATCH_SIZE=5
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VALUSee_MFA_ENCRYPTION_KEY=replace-with-a-generated-fernet-key
# Exact reverse-proxy IPs only. Never use * in production.
FORWARDED_ALLOW_IPS=127.0.0.1
VALUSee_QUEUE_RETRY_DELAY_MS=30000
VALUSee_QUEUE_MAX_RETRIES=5

# Optional LLM. Leave OPENAI_API_KEY empty to keep deterministic fallback mode.
# OpenAI: use https://api.openai.com/v1 with Chat Completions (the default).
# For the 粥/Congee gateway, use OPENAI_BASE_URL=https://congee.pro and OPENAI_WIRE_API=responses.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_WIRE_API=chat_completions
DEV_AGENT_LLM_MODEL=gpt-4o-mini
# Optional multimodal model used for uploaded product screenshots. Defaults to DEV_AGENT_LLM_MODEL.
VALUSee_VISION_MODEL=gpt-4o-mini
# Optional automatic fallback when the primary visual provider is unavailable.
OPENAI_VISION_FALLBACK_API_KEY=
OPENAI_VISION_FALLBACK_BASE_URL=
OPENAI_VISION_FALLBACK_MODEL=gpt-4o-mini
OPENAI_VISION_FALLBACK_WIRE_API=chat_completions

# Optional per-Agent overrides. Blank values inherit DEV_AGENT_LLM_MODEL.
DEV_AGENT_LLM_MODEL_PLANNER=
DEV_AGENT_LLM_MODEL_REPORTER=
DEV_AGENT_LLM_MODEL_SUPERVISOR=
DEV_AGENT_LLM_MODEL_PROJECT_ANALYZER=
DEV_AGENT_LLM_MODEL_CODE_REVIEWER=
DEV_AGENT_LLM_MODEL_FILE_REVIEWER=
DEV_AGENT_LLM_MODEL_TASK_QA=
DEV_AGENT_LLM_MODEL_LEARNING_COACH=
DEV_AGENT_LLM_MODEL_MEMORY_EXTRACTOR=
# Alternative compact format: planner:model-a,reporter:model-b
DEV_AGENT_LLM_AGENT_MODELS=

# Governed memory extraction and pgvector embeddings.
DEV_AGENT_MEMORY_EXTRACTOR=llm
DEV_AGENT_EMBEDDING_MODEL=text-embedding-3-small
DEV_AGENT_EMBEDDING_DIM=1536

# Optional dashboard cost estimates in USD per 1M tokens.
DEV_AGENT_LLM_PRICE_GPT_4O_MINI_INPUT_PER_1M=
DEV_AGENT_LLM_PRICE_GPT_4O_MINI_OUTPUT_PER_1M=

# Optional notification delivery
VALUSee_SMTP_HOST=
VALUSee_SMTP_PORT=465
VALUSee_SMTP_USERNAME=
VALUSee_SMTP_PASSWORD=
VALUSee_SMTP_FROM=
VALUSee_SMTP_SSL=true

# Optional signed notification relay for SMS, mobile Push, or another delivery provider.
VALUSee_NOTIFICATION_WEBHOOK_URL=
VALUSee_NOTIFICATION_WEBHOOK_SECRET=

# Authorized commerce platform credentials. Keep blank until approved by each platform.
JD_APP_KEY=
JD_APP_SECRET=
JD_UNION_PID=
JD_ADAPTER_BASE_URL=
JD_ADAPTER_TOKEN=
TAOBAO_APP_KEY=
TAOBAO_APP_SECRET=
TAOBAO_ADAPTER_BASE_URL=
TAOBAO_ADAPTER_TOKEN=
PDD_CLIENT_ID=
PDD_CLIENT_SECRET=
PDD_ADAPTER_BASE_URL=
PDD_ADAPTER_TOKEN=
# Unified ValuSee-compatible adapter registry. Empty means no live search source.
VALUSee_COMMERCE_PROVIDERS=[]
