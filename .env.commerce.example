# Copy the needed lines into a private .env file. Never commit this file with real credentials.
# The key/secret values below are platform credentials, not ValuSee application secrets.

# JD Union / Open Platform credentials.
JD_APP_KEY=
JD_APP_SECRET=
JD_UNION_PID=
# URL of the ValuSee-compatible JD adapter after its field/signature mapping is deployed.
JD_ADAPTER_BASE_URL=
JD_ADAPTER_TOKEN=

# Optional Taobao/Tmall and Pinduoduo adapters for later activation.
TAOBAO_APP_KEY=
TAOBAO_APP_SECRET=
TAOBAO_ADAPTER_BASE_URL=
TAOBAO_ADAPTER_TOKEN=
PDD_CLIENT_ID=
PDD_CLIENT_SECRET=
PDD_ADAPTER_BASE_URL=
PDD_ADAPTER_TOKEN=

# Unified adapter registry. Keep this JSON valid; empty means no live search source.
VALUSee_COMMERCE_PROVIDERS=[]
