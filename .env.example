APP_NAME=DevAgent Studio
APP_ENV=dev
MAX_SCAN_FILES=800
MAX_FILE_PREVIEW_CHARS=4000

# Optional LLM hot-plug config. Edit .env and the next LLM call will use it.
OPENAI_API_KEY=
DEV_AGENT_LLM_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=

# Optional per-Agent model overrides. These are hot-read on each LLM call.
# DEV_AGENT_LLM_MODEL_PLANNER=gpt-4o-mini
# DEV_AGENT_LLM_MODEL_REPORTER=gpt-4.1-mini
# DEV_AGENT_LLM_MODEL_SUPERVISOR=gpt-4.1-mini
# DEV_AGENT_LLM_MODEL_PROJECT_ANALYZER=gpt-4o-mini
# DEV_AGENT_LLM_MODEL_CODE_REVIEWER=gpt-4.1-mini
# DEV_AGENT_LLM_MODEL_FILE_REVIEWER=gpt-4.1-mini
# DEV_AGENT_LLM_MODEL_TASK_QA=gpt-4o-mini
# DEV_AGENT_LLM_MODEL_LEARNING_COACH=gpt-4o-mini
# DEV_AGENT_LLM_MODEL_MEMORY_EXTRACTOR=gpt-4o-mini
# DEV_AGENT_LLM_AGENT_MODELS=planner:gpt-4o-mini,reporter:gpt-4.1-mini,supervisor:gpt-4.1-mini

# Optional prompt version overrides. These are hot-read on each LLM call.
# DEV_AGENT_PROMPT_PLANNER=planner.v2
# DEV_AGENT_PROMPT_REPORTER=reporter.v2
# DEV_AGENT_PROMPT_SUPERVISOR=supervisor.v2
# DEV_AGENT_PROMPT_PROJECT_ANALYZER_ARCHITECTURE=project_analyzer.architecture.v2
# DEV_AGENT_PROMPT_CODE_REVIEWER_SUGGESTIONS=code_reviewer.suggestions.v2
# DEV_AGENT_PROMPT_FILE_REVIEWER_SEMANTIC=file_reviewer.semantic.v2
# DEV_AGENT_PROMPT_TASK_QA=task_qa.v2
# DEV_AGENT_PROMPT_LEARNING_COACH_REPLY=learning_coach.reply.v2
# DEV_AGENT_PROMPT_LEARNING_COACH_QUESTIONS=learning_coach.questions.v2
# DEV_AGENT_PROMPT_MEMORY_EXTRACTOR=memory_extractor.v1

# Long-term memory extraction: llm uses the governed LLM extractor when a key is configured;
# otherwise the application falls back to explicit-preference rules. Set to rule to disable LLM extraction.
DEV_AGENT_MEMORY_EXTRACTOR=llm

# Optional model price estimates, USD per 1M tokens. Used only by the dashboard.
# DEV_AGENT_LLM_PRICE_GPT_4O_MINI_INPUT_PER_1M=
# DEV_AGENT_LLM_PRICE_GPT_4O_MINI_OUTPUT_PER_1M=

# RAG store: sqlite keyword fallback or pgvector semantic retrieval.
DEV_AGENT_RAG_STORE=sqlite
# PGVECTOR_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dev_agent_studio
DEV_AGENT_EMBEDDING_MODEL=text-embedding-3-small
DEV_AGENT_EMBEDDING_DIM=1536

# MCP provider switch.
# local = built-in deterministic filesystem/git adapter.
# mcp = real stdio MCP client using server configs saved through /api/v1/mcp/servers.
DEV_AGENT_MCP_PROVIDER=local

# GitHub PR integration.
# Token needs pull request read access and issues/pull-requests write access for comments.
# GITHUB_TOKEN=
# GITHUB_API_BASE=https://api.github.com
# GITHUB_WEBHOOK_SECRET=
# DEV_AGENT_GITHUB_POST_COMMENT=false

# Code Skill sandbox.
# subprocess = local isolated Python child process.
# docker = stronger sandbox for execution_type=python skills.
# Docker mode uses: --network none, --read-only, --cap-drop ALL,
# no-new-privileges, memory/CPU/PID limits, read-only skill mount.
DEV_AGENT_SKILL_SANDBOX=subprocess
DEV_AGENT_SKILL_SANDBOX_IMAGE=python:3.13-slim
DEV_AGENT_SKILL_SANDBOX_MEMORY=256m
DEV_AGENT_SKILL_SANDBOX_CPUS=0.5
DEV_AGENT_SKILL_SANDBOX_PIDS_LIMIT=64
# Keep false in production so Docker failures do not silently downgrade.
DEV_AGENT_SKILL_SANDBOX_FALLBACK=false
APP_ENV=dev
VALUSee_JWT_SECRET=change-this-before-production
VALUSee_ADMIN_EMAILS=
VALUSee_MONITOR_INTERVAL_SECONDS=60
VALUSee_PUBLIC_BASE_URL=http://127.0.0.1:8200
# Production storage and integrations (leave empty for local development)
# DATABASE_URL=postgresql://valuesee:password@localhost:5432/valuesee
# REDIS_URL=redis://localhost:6379/0
# RABBITMQ_URL=amqp://valuesee:password@localhost:5672/%2F
# S3_ENDPOINT_URL=http://localhost:9000
# S3_BUCKET=valuesee-uploads
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=change-this
# VALUSee_COMMERCE_PROVIDERS=[]
# See `.env.commerce.example` for JD/Taobao/Pinduoduo credential placeholders.
# VALUSee_NOTIFICATION_WEBHOOK_URL=
# VALUSee_NOTIFICATION_WEBHOOK_SECRET=
# Optional account-email notification delivery. Use an SMTP authorization code, not the mailbox login password.
# VALUSee_SMTP_HOST=
# VALUSee_SMTP_PORT=465
# VALUSee_SMTP_USERNAME=
# VALUSee_SMTP_PASSWORD=
# VALUSee_SMTP_FROM=
# VALUSee_SMTP_SSL=true
