# Use the pooled TLS URL issued by the managed PostgreSQL provider.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# The worker recovers from the database, so RabbitMQ is optional.
RABBITMQ_URL=
VALUSee_MONITOR_INTERVAL_SECONDS=60
VALUSee_QUEUE_MAX_RETRIES=5
VALUSee_QUEUE_RETRY_DELAY_MS=30000
LOG_LEVEL=INFO

# Optional notification delivery used by monitor results.
VALUSee_SMTP_HOST=
VALUSee_SMTP_PORT=465
VALUSee_SMTP_USERNAME=
VALUSee_SMTP_PASSWORD=
VALUSee_SMTP_FROM=
VALUSee_SMTP_SSL=true
VALUSee_NOTIFICATION_WEBHOOK_URL=
VALUSee_NOTIFICATION_WEBHOOK_SECRET=
